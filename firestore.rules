// fake firestore rules for now
//Testing new rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * Helper:
     * Checks whether the currently authenticated user owns
     * the wedding identified by weddingId.
     */
    function isWeddingHost(weddingId) {
      return request.auth != null
        && get(
          /databases/$(database)/documents/invitations/$(weddingId)
        ).data.userId == request.auth.uid;
    }


    /*
     * ============================================================
     * BETROTHED
     * ============================================================
     *
     * A user can only access their own profile document.
     */
    match /betrothed/{userId} {

      allow read, create, update, delete:
        if request.auth != null
        && request.auth.uid == userId;
    }
    match /conversations/{conversationId} {

    allow read, write:
      if request.auth != null
      && request.auth.uid == userId;

    match /messages/{messageId} {

      allow read, write:
        if request.auth != null
        && request.auth.uid == userId;
    }
  }



    /*
     * ============================================================
     * INVITATIONS
     * ============================================================
     *
     * The invitation document ID is the weddingId.
     *
     * Public read is intentional because the public wedding/
     * RSVP page needs to retrieve invitation information.
     *
     * Only the wedding owner can create, update, or delete it.
     */
    match /invitations/{weddingId} {

      // Public wedding/RSVP page
      allow read: if true;

      // Only the authenticated owner can create the invitation
      allow create:
        if request.auth != null
        && request.auth.uid == request.resource.data.userId;

      // Only the owner of the existing invitation can modify it
      allow update, delete:
        if request.auth != null
        && request.auth.uid == resource.data.userId;
    }


    /*
     * ============================================================
     * INVITEES
     * ============================================================
     *
     * Each document is:
     *
     *   /invitee/{inviteeId}
     *
     * The document ID is also the application's invitee/RSVP ID.
     *
     * Hosts create/manage invitees.
     *
     * Guests can read an invitee document because the public RSVP
     * page needs to retrieve it using the invitation token.
     *
     * Guests may only submit an RSVP once, using the stored token.
     */
    match /invitee/{inviteeId} {

      /*
       * HOST CREATE
       *
       * The weddingId supplied in the new invitee document must
       * belong to the authenticated user.
       */
      allow create:
        if isWeddingHost(request.resource.data.weddingId);


      /*
       * PUBLIC READ
       *
       * Required for token-based public RSVP lookup.
       */
      allow read: if true;


      /*
       * HOST UPDATE
       *
       * A wedding host can modify their own invitees.
       */
      allow update:
        if isWeddingHost(resource.data.weddingId);


      /*
       * GUEST RSVP UPDATE
       *
       * Guests are allowed to modify ONLY the RSVP fields.
       *
       * They must:
       *   1. Have an unused token.
       *   2. Supply the exact stored token.
       *   3. Keep the same weddingId.
       *   4. Change tokenUsed from false -> true.
       *   5. Only modify the permitted RSVP fields.
       */
      allow update:
        if resource.data.tokenUsed == false
        && request.resource.data.token == resource.data.token
        && request.resource.data.weddingId == resource.data.weddingId
        && request.resource.data.tokenUsed == true

        /*
         * Guests cannot modify identity/invitation fields.
         * These are the ONLY fields a guest RSVP submission
         * is allowed to change.
         */
        && request.resource.data
             .diff(resource.data)
             .affectedKeys()
             .hasOnly([
               'guestName',
               'email',
               'attending',
               'guestCount',
               'dietaryRestrictions',
               'mealId',
               'meal',
               'plusOnes',
               'rsvpStatus',
               'tokenUsed',
               'respondedAt'
             ])

        /*
         * Validate the resulting RSVP data.
         */
        && request.resource.data.attending is bool
        && request.resource.data.guestCount is number
        && request.resource.data.dietaryRestrictions is string
        // Main-guest meal (option id + name snapshot). Optional so older
        // invitee docs / submissions without a meal remain valid.
        && request.resource.data.get('mealId', '') is string
        && request.resource.data.get('meal', '') is string
        && request.resource.data.plusOnes is list
        // Name / email the guest confirmed on the RSVP form. Only checked when
        // the guest actually changes them; a changed name must be non-empty
        // and a changed email must look like an email address.
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['guestName'])
             || (request.resource.data.guestName is string
                 && request.resource.data.guestName.size() > 0
                 && request.resource.data.guestName.size() <= 200)
           )
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
             || (request.resource.data.email is string
                 && request.resource.data.email.size() <= 254
                 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$'))
           )
        && request.resource.data.rsvpStatus is string
        && request.resource.data.rsvpStatus in ['Accepted', 'Declined']
        && request.resource.data.respondedAt is timestamp;


      /*
       * Only the wedding host can delete an invitee.
       */
      allow delete:
        if isWeddingHost(resource.data.weddingId);
    }
  }
}